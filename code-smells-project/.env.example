# Exporte estas variáveis no ambiente antes de subir a aplicação (não há loader de .env embutido).
SECRET_KEY=replace-with-a-random-value
DEBUG=false
HOST=127.0.0.1
PORT=5000
DB_PATH=loja.db
CORS_ORIGINS=http://localhost:3000
TOKEN_TTL_SECONDS=28800
APP_ENV=producao
SEED_DEMO_DATA=true
LOG_LEVEL=INFO
