PORT=3000
# Token exigido em "Authorization: Bearer <token>" nas rotas administrativas.
# Sem ele, essas rotas respondem 401. Gere com: openssl rand -hex 32
ADMIN_API_TOKEN=
# Chave do gateway de pagamento (o gateway atual é simulado e não a utiliza).
PAYMENT_GATEWAY_KEY=
# Arquivo SQLite; o padrão é banco em memória.
DB_FILE=:memory:
